.DS_Store
__pycache__/
*.pyc
build/
builds/
.godot/
*.apk
*.aab

# Keystore dan kredensial export tidak pernah masuk repo (git-workflow, privacy-ads).
# Keystore rilis disimpan di luar folder project; keystore debug dibuat Godot di folder editor.
*.keystore
*.jks
*.p12
export_credentials.cfg

# override.cfg mengubah pengaturan proyek diam-diam di mesin lokal; tidak pernah di-commit (probe render memakai
# tools/ekspor_cek_render.py, bukan override.cfg).
override.cfg

# .cursor/rules adalah sumber aturan agent dan harus ikut di-commit,
# walau .gitignore global mengabaikan .cursor/
!.cursor/
